# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection URI (required — connects to digital_footprint_visualizer)
MONGODB_URI=""

# JWT Signing Secret
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# GEMINI_API_KEY: Required for optional server-side AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
